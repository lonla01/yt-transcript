# Clé OpenAI, utilisée seulement quand la vidéo n'a pas de sous-titres (repli Whisper)
OPENAI_API_KEY=
# Modèle de transcription audio (défaut : whisper-1)
TRANSCRIPTION_MODEL=whisper-1
# Port du serveur
PORT=3000
# Durée max (minutes) pour le repli audio. 25 Mo d'audio mono 32 kb/s ≈ 100 min
MAX_AUDIO_MINUTES=100

# --- Si YouTube bloque le serveur (erreur « bloque temporairement ») ---
# Proxy (de préférence résidentiel) : http://utilisateur:motdepasse@hote:port
YTDLP_PROXY=
# Cookies YouTube au format cookies.txt, encodés en base64 (voir README)
YTDLP_COOKIES_B64=
# ... ou chemin d'un fichier cookies.txt (usage local)
YTDLP_COOKIES_FILE=
# Options yt-dlp supplémentaires, séparées par des espaces
YTDLP_EXTRA_ARGS=
